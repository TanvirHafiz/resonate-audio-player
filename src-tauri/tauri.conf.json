{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonate",
  "version": "0.1.0",
  "identifier": "com.steam.resonate",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Resonate",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
